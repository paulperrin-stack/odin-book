generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Starter model - extend or replace as the project grows.
model User {
    id          Int             @id @default(autoincrement())
    email       String?         @unique // nullable: GitHub users may not return one
    password    String?                 // nullable: OAuth users have no password
    githubId    String?         @unique // OAuth identify
    username    String?         
    displayName String?
    avatarUrl   String?
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @updatedAt
}