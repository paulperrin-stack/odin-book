generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Starter model - extend or replace as the project grows.
model User {
    id          Int         @id @default(autoincrement())
    email       String      @unique
    password    String
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
}